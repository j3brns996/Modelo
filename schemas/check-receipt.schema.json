{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelo.invalid/schemas/check-receipt.schema.json",
  "title": "Modelo detached pre-merge check receipt",
  "$defs": {
    "canonicalBaseUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?!.*(?:/\\.{1,2})(?:/|(?![\\s\\S])))[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?:/[A-Za-z0-9._~-]+)*/(?![\\s\\S])",
      "maxLength": 2048
    },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "common.schema.json#/$defs/safeRelativePath" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "artifactDigests": {
      "type": "object",
      "required": ["catalogue", "publication", "manifest"],
      "properties": {
        "catalogue": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "path": { "const": "site/data/catalogue.json" } } }] },
        "publication": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "path": { "const": "site" } } }] },
        "manifest": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "path": { "const": "site/data/manifest.json" } } }] }
      },
      "additionalProperties": false
    },
    "ci": {
      "type": "object",
      "required": ["provider", "workflow_identity", "run_id", "check", "result", "head_sha"],
      "properties": {
        "provider": { "enum": ["github", "gitlab"] },
        "workflow_identity": { "type": "string", "minLength": 1, "maxLength": 256 },
        "run_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "check": { "const": "modelo/check" },
        "result": { "const": "success" },
        "head_sha": { "$ref": "common.schema.json#/$defs/gitSha" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["contract_version", "repository", "base_sha", "head_sha", "head_tree_sha", "as_of", "source_date_epoch", "profile", "base_url", "base_path", "promotion_durability", "artifacts", "tool_digest", "lock_digest", "actors_registry_digest", "mac_issue", "mac_payload_digest", "change_delta", "ci"],
  "properties": {
    "contract_version": { "const": "0.1.0" },
    "repository": {
      "type": "object",
      "required": ["provider", "host", "namespace", "name"],
      "properties": {
        "provider": { "enum": ["github", "gitlab"] },
        "host": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?![\\s\\S])", "maxLength": 253 },
        "namespace": { "type": "string", "minLength": 1, "maxLength": 256 },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "additionalProperties": false
    },
    "base_sha": { "$ref": "common.schema.json#/$defs/gitSha" },
    "head_sha": { "$ref": "common.schema.json#/$defs/gitSha" },
    "head_tree_sha": { "$ref": "common.schema.json#/$defs/gitSha" },
    "as_of": { "type": "string", "format": "date" },
    "source_date_epoch": { "type": "integer", "minimum": 0 },
    "profile": { "enum": ["synthetic", "private"] },
    "base_url": { "$ref": "#/$defs/canonicalBaseUrl" },
    "base_path": { "type": "string", "pattern": "^/(?!/)(?!.*//)(?!.*%)(?!.*\\.\\.)(?!.*(?:/\\./|/\\.(?![\\s\\S])))(?!.*[\\u0000-\\u001f\\u007f])(?:[A-Za-z0-9._~-]+/)*(?![\\s\\S])", "maxLength": 512 },
    "promotion_durability": { "const": "fsync-durable" },
    "artifacts": { "$ref": "#/$defs/artifactDigests" },
    "tool_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "lock_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "actors_registry_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "mac_issue": { "type": "string", "minLength": 1, "maxLength": 256 },
    "mac_payload_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "change_delta": { "$ref": "release-receipt.schema.json#/$defs/changeDeltaList" },
    "ci": { "$ref": "#/$defs/ci" }
  },
  "additionalProperties": false
}
