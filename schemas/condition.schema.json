{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelo.invalid/schemas/condition.schema.json",
  "title": "Modelo enterprise condition version",
  "type": "object",
  "required": ["id", "version", "title", "description", "owner"],
