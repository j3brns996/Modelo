{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelo.invalid/schemas/providers/aws-bedrock-route.schema.json",
  "title": "Modelo AWS Bedrock route",
  "$defs": {
    "awsRegion": {
      "type": "string",
      "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-[0-9]+(?![\\s\\S])"
    },
    "foundationModelReference": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?!(?:us|eu|apac|global)\\.)[a-z0-9-]{1,63}(?:\\.[a-z0-9-]{1,63}){1,3}(?::[a-z0-9-]{1,63}){0,2}(?![\\s\\S])"
        },
        {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^arn:(?:aws|aws-us-gov|aws-cn):bedrock:[a-z0-9-]{1,20}::foundation-model/(?!(?:us|eu|apac|global)\\.)[a-z0-9-]{1,63}(?:\\.[a-z0-9-]{1,63}){1,3}(?::[a-z0-9-]{1,63}){0,2}(?![\\s\\S])"
        }
      ]
    },
    "systemInferenceProfileReference": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:us|eu|apac|global)\\.[a-z0-9-]{1,63}(?:\\.[a-z0-9-]{1,63}){1,3}(?::[a-z0-9-]{1,63}){0,2}(?![\\s\\S])"
        },
        {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^arn:(?:aws|aws-us-gov|aws-cn):bedrock:[a-z0-9-]{1,20}::inference-profile/(?:us|eu|apac|global)\\.[a-z0-9-]{1,63}(?:\\.[a-z0-9-]{1,63}){1,3}(?::[a-z0-9-]{1,63}){0,2}(?![\\s\\S])"
        }
      ]
    },
    "modelEvidence": {
      "type": "object",
      "required": ["id", "arn_pointer", "name_pointer", "provider_pointer"],
      "properties": {
        "id": { "$ref": "../common.schema.json#/$defs/evidenceId" },
        "id_pointer": { "$ref": "../common.schema.json#/$defs/nonRootJsonPointer" },
        "arn_pointer": { "$ref": "../common.schema.json#/$defs/nonRootJsonPointer" },
        "name_pointer": { "$ref": "../common.schema.json#/$defs/nonRootJsonPointer" },
        "provider_pointer": { "$ref": "../common.schema.json#/$defs/nonRootJsonPointer" }
      },
      "additionalProperties": false
    },
    "foundationModelBinding": {
      "type": "object",
      "required": ["kind", "model_evidence"],
      "properties": {
        "kind": { "const": "foundation-model" },
        "model_evidence": {
          "allOf": [
            { "$ref": "#/$defs/modelEvidence" },
            { "required": ["id_pointer"] }
          ]
        }
      },
      "additionalProperties": false
    },
    "profileEvidence": {
      "type": "object",
      "required": ["id", "projection_pointer", "type_pointer", "status_pointer", "destinations_pointer"],
      "properties": {
        "id": { "$ref": "../common.schema.json#/$defs/evidenceId" },
        "projection_pointer": { "$ref": "../common.schema.json#/$defs/nonRootJsonPointer" },
        "type_pointer": { "$ref": "../common.schema.json#/$defs/nonRootJsonPointer" },
        "status_pointer": { "$ref": "../common.schema.json#/$defs/nonRootJsonPointer" },
        "destinations_pointer": { "$ref": "../common.schema.json#/$defs/nonRootJsonPointer" }
      },
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "required": ["destination_pointer", "model_evidence"],
      "properties": {
        "destination_pointer": { "$ref": "../common.schema.json#/$defs/nonRootJsonPointer" },
        "model_evidence": { "$ref": "#/$defs/modelEvidence" }
      },
      "additionalProperties": false
    },
    "systemProfileBinding": {
      "type": "object",
      "required": ["kind", "profile_evidence", "destinations"],
      "properties": {
        "kind": { "const": "system-inference-profile" },
        "profile_evidence": { "$ref": "#/$defs/profileEvidence" },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/destination" }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["id", "source_region", "reference", "model_binding"],
  "properties": {
    "id": { "$ref": "../common.schema.json#/$defs/id", "x-modelo-provenance": "internal" },
    "source_region": {
      "$ref": "#/$defs/awsRegion",
      "x-modelo-provenance": "internal"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "x-modelo-provenance": "external",
      "x-modelo-freshness-class": "availability"
    },
    "model_binding": {
      "oneOf": [
        { "$ref": "#/$defs/foundationModelBinding" },
        { "$ref": "#/$defs/systemProfileBinding" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "model_binding": {
            "properties": { "kind": { "const": "foundation-model" } },
            "required": ["kind"]
          }
        },
        "required": ["model_binding"]
      },
      "then": { "properties": { "reference": { "$ref": "#/$defs/foundationModelReference" } } }
    },
    {
      "if": {
        "properties": {
          "model_binding": {
            "properties": { "kind": { "const": "system-inference-profile" } },
            "required": ["kind"]
          }
        },
        "required": ["model_binding"]
      },
      "then": { "properties": { "reference": { "$ref": "#/$defs/systemInferenceProfileReference" } } }
    }
  ],
  "additionalProperties": false
}
