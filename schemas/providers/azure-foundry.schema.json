{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelo.invalid/schemas/providers/azure-foundry.schema.json",
  "title": "Modelo Azure AI Foundry route",
  "$defs": {
    "azureRegion": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?![\\s\\S])"
    },
    "deploymentModelReference": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]{1,64}(?![\\s\\S])"
        },
        {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^/subscriptions/[a-f0-9-]{36}/resourceGroups/[a-zA-Z0-9._-]+/providers/Microsoft\\.CognitiveServices/accounts/[a-zA-Z0-9-]+/deployments/[a-zA-Z0-9_-]{1,64}(?![\\s\\S])"
        }
      ]
    },
    "modelEvidence": {
      "type": "object",
      "required": ["id", "name_pointer", "provider_pointer"],
      "properties": {
        "id": { "$ref": "../common.schema.json#/$defs/evidenceId" },
        "id_pointer": { "$ref": "../common.schema.json#/$defs/nonRootJsonPointer" },
        "resource_pointer": { "$ref": "../common.schema.json#/$defs/nonRootJsonPointer" },
        "name_pointer": { "$ref": "../common.schema.json#/$defs/nonRootJsonPointer" },
        "provider_pointer": { "$ref": "../common.schema.json#/$defs/nonRootJsonPointer" }
      },
      "additionalProperties": false
    },
    "deploymentModelBinding": {
      "type": "object",
      "required": ["kind", "model_evidence"],
      "properties": {
        "kind": { "const": "deployment-model" },
        "model_evidence": {
          "allOf": [
            { "$ref": "#/$defs/modelEvidence" },
            { "required": ["id_pointer"] }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["id", "region", "reference", "model_binding"],
  "properties": {
    "id": { "$ref": "../common.schema.json#/$defs/id", "x-modelo-provenance": "internal" },
    "region": {
      "$ref": "#/$defs/azureRegion",
      "x-modelo-provenance": "internal"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "x-modelo-provenance": "external",
      "x-modelo-freshness-class": "availability"
    },
    "model_binding": {
      "oneOf": [
        { "$ref": "#/$defs/deploymentModelBinding" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "model_binding": {
            "properties": { "kind": { "const": "deployment-model" } },
            "required": ["kind"]
          }
        },
        "required": ["model_binding"]
      },
      "then": { "properties": { "reference": { "$ref": "#/$defs/deploymentModelReference" } } }
    }
  ],
  "additionalProperties": false
}
